# ============================================================
# AI Interviewer — environment template (Milestone 2)
# Copy to .env (API) and apps/web/.env (web) as needed.
# Real secrets live ONLY in host dashboards, never in git.
# ============================================================

# --- API (apps/api) ---
PORT=5000
# MongoDB connection. Leave EMPTY for offline/local dev without a database —
# the server still starts and /api/health reports db:"not_configured".
# Local (docker compose):  mongodb://localhost:27017/ai_interviewer
# Deployed demo:           Atlas M0 connection string (see README deploy steps)
MONGODB_URI=
# Allowed frontend origin(s), comma-separated. Deployed: your Vercel URL, e.g.
# https://ai-interviewer-web.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- Web (apps/web; Vite reads VITE_* at build time) ---
# Deployed: https://<your-render-service>.onrender.com
VITE_API_URL=http://localhost:5000

# --- LLM gateway (Milestone 2; spec Section 8) ---
# The owner creates these in Google AI Studio / Groq / OpenRouter and pastes
# them into the HOST DASHBOARD (Render -> Environment), never into git or chat.
# The gateway skips any provider whose key is missing; with NO keys at all it
# serves deterministic mocks so the pipeline runs end-to-end (ADR 002).
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=     # optional extra fallback
# --- Dev-only ---
# OLLAMA_ENABLED=true     # local dev only; never in the visitor's path
# OLLAMA_BASE_URL=http://localhost:11434
# --- Test hooks (do not set in production) ---
# GEMINI_BASE_URL=        # override the Gemini REST endpoint (tests use this)
# GROQ_BASE_URL=          # override, e.g. http://127.0.0.1:5387
# OPENROUTER_BASE_URL=
